<header class="titulo-pagina">
  <p class="rotulo">Consulta concluída</p>
  <h1>{{titulo}}</h1>
  <p class="contador">
    <strong>{{quantidade}}</strong> registros
  </p>
</header>

{{#if possuiCursos}}
  <section class="grade" aria-label="Lista de cursos">
    {{#each cursos}}
      {{> componente-cursos-oficinas lista=true}}
    {{/each}}
  </section>
{{else}}
  <section class="estado-vazio">
    <h2>Nenhum curso cadastrado</h2>
    <p>O banco de dados ainda não possui registros para apresentar.</p>
  </section>
{{/if}}
